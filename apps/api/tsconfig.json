{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "dist",
    "incremental": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
