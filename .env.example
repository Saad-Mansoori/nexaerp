# NexaERP environment template — copy to `.env` and fill in local values.
# NEVER commit `.env` (gitignored); this template contains placeholders only.
# Single source of truth for every variable: docs/ARCHITECTURE.md §17.

# ── apps/api (Render env + local .env) ────────────────────────────────
NODE_ENV=development
PORT=4000
# CORS allowlist, comma-separated origins
WEB_ORIGIN=http://localhost:3000
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local Postgres from `docker compose up -d postgres` (superuser-free, trust auth)
DATABASE_URL=postgresql://nexaerp@localhost:5432/nexaerp
# Migrator connection used by `prisma migrate` (Prisma Config; local = same DB)
DIRECT_URL=postgresql://nexaerp@localhost:5432/nexaerp

# Rate limiting (documented fallbacks: 300 requests / 60000 ms per identity)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# Run `prisma migrate deploy` at boot — single instance only.
# The boot-time runner is active from Phase 2; documented here from Phase 1.
AUTO_MIGRATE=false

# Supabase (auth + storage arrive in Phase 2 — leave blank until then)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ── apps/web (Vercel env + local .env) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── CI-only ───────────────────────────────────────────────────────────
# Local integration tests use the `postgres-test` container (port 5433):
TEST_DATABASE_URL=postgresql://nexaerp@localhost:5433/nexaerp_test
